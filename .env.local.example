# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# .env.local NUNCA é commitado (ver .gitignore).

# --- Anthropic (IA) ---
# Usada SOMENTE em Route Handlers do servidor (app/api/**). Nunca expor ao client.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase ---
# URL do projeto: Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Service role key: Supabase Dashboard > Project Settings > API Keys
# Tem acesso total (bypassa RLS) — usar SOMENTE no servidor (Route Handlers),
# nunca prefixar com NEXT_PUBLIC_ e nunca expor ao client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase Auth (client) ---
# Mesma URL do projeto acima, mas exposta ao client (prefixo NEXT_PUBLIC_
# obrigatório) — usada pelo client de browser (lib/supabase-browser.ts) e
# pelo middleware para gerenciar a sessão de login.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Anon/public key: Supabase Dashboard > Project Settings > API Keys.
# Respeita RLS — segura para expor ao client (diferente da service role key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth (configurado no Supabase Dashboard, não aqui) ---
# Authentication > Providers > Google: precisa de Client ID + Client Secret
# do Google Cloud Console. Ver supabase/schema.sql e handoff do projeto para
# o passo a passo. Sem isso, /login não completa o fluxo OAuth.
